{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile storing their professional clinical background",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "Clinical role (e.g., Medical Student, Physician)"
        },
        "email": {
          "type": "string",
          "description": "User email from OAuth"
        }
      },
      "required": ["role", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles keyed by their Firebase Auth UID."
    }
  }
}
